# Database connection (PostgreSQL)
# e.g., Supabase, Neon, Docker postgres, or local PostgreSQL instance
DATABASE_URL="postgresql://virella:virella_secret@localhost:5432/virella_db?schema=public"

# Auth.js / NextAuth v5 Secret (generate via `npx auth secret` or `openssl rand -hex 32`)
AUTH_SECRET="your-generated-32-byte-hex-secret-here"

# Public Application URL
APP_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth Credentials
# Authorized Redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Email Service (Resend)
# If left empty, verification and password reset links are automatically printed to the terminal console in development!
RESEND_API_KEY=""
EMAIL_FROM="Virella Study <noreply@virellastudy.com>"

# LiveKit WebRTC Audio/Video (LiveKit Cloud or Self-hosted SFU)
# Free tier on cloud.livekit.io (50 GB bandwidth/month, 100 concurrent participants)
LIVEKIT_URL=""
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""
NEXT_PUBLIC_LIVEKIT_URL=""
